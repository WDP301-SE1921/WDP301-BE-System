NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:<password>@localhost:3306/edugrade_db"
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
WEB_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=<replace-with-at-least-32-characters>
JWT_REFRESH_SECRET=<replace-with-at-least-32-characters>
JWT_ISSUER=edugrade-api
JWT_AUDIENCE=edugrade-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Requests per minute per client before HTTP 429 (default 120).
THROTTLE_LIMIT_PER_MINUTE=120

# Seed (pnpm db:seed): creates one account per role when the email does not exist yet.
# Existing accounts are never modified. Required: SEED_DEFAULT_PASSWORD.
SEED_DEFAULT_PASSWORD=<replace-with-a-strong-password>
SEED_MANAGER_EMAIL=manager@edugrade.local
SEED_STAFF_EMAIL=staff@edugrade.local
SEED_TEACHER_EMAIL=teacher@edugrade.local
SEED_CURRICULUM_DESIGNER_EMAIL=designer@edugrade.local
SEED_PARENT_EMAIL=parent@edugrade.local
# Only for seeding a production database: SEED_ALLOW_PRODUCTION=true

# Optional P1 integrations. Missing values disable only the related operation.
# Full Chat Completions-compatible endpoint; model must support JSON output.
AI_CHAT_URL=
AI_API_KEY=
AI_MODEL=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SMTP_URL=
MAIL_FROM=

NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:<password>@localhost:3306/edugrade_db"
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:3001
WEB_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=<replace-with-at-least-32-characters>
JWT_REFRESH_SECRET=<replace-with-at-least-32-characters>
JWT_ISSUER=edugrade-api
JWT_AUDIENCE=edugrade-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Each refresh extends the session by JWT_REFRESH_TTL_SECONDS, never past this age from login (default 90 days).
JWT_SESSION_MAX_AGE_SECONDS=7776000
# Requests per minute per client before HTTP 429 (default 120).
THROTTLE_LIMIT_PER_MINUTE=120

# Browser push notifications. Generate once with: pnpm exec web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY only on the backend; VAPID_PUBLIC_KEY is safe for browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Center contact details for public GET /center (bill, receipt, tuition in apps), stored in the
# center_profiles table. pnpm seed creates the row (demo values in demo mode) and writes every
# non-empty CENTER_* value below into it; empty values keep what the table already has.
CENTER_NAME=
CENTER_ADDRESS=
CENTER_PHONE=
CENTER_EMAIL=
CENTER_OPENING_HOURS=

# Seed (pnpm seed): demo data by default in development/test; accounts only in production.
# Existing records and passwords are preserved. Required: SEED_DEFAULT_PASSWORD.
# Reseed (pnpm reseed): deletes ALL data in DATABASE_URL, reapplies migrations, then seeds.
# Reseed only permits NODE_ENV=development or NODE_ENV=test.
SEED_MODE=demo
# Optional YYYY-MM-DD reference date, persisted on first demo seed (default: today in Vietnam).
# SEED_REFERENCE_DATE=2026-10-14
SEED_DEFAULT_PASSWORD=<replace-with-a-strong-password>
SEED_ADMIN_EMAIL=admin@edugrade.local
SEED_MANAGER_EMAIL=manager@edugrade.local
SEED_STAFF_EMAIL=staff@edugrade.local
SEED_TEACHER_EMAIL=teacher@edugrade.local
SEED_CURRICULUM_DESIGNER_EMAIL=designer@edugrade.local
SEED_PARENT_EMAIL=parent@edugrade.local
# Production account seeding requires SEED_MODE=accounts and SEED_ALLOW_PRODUCTION=true.

# MinIO Root credentials (used only by Docker minio and minio-init services)
MINIO_ROOT_USER=<minio-root-username>
MINIO_ROOT_PASSWORD=<minio-root-password-at-least-8-chars>

# Optional P1 integrations. Missing values disable only the related operation.
# Full Chat Completions-compatible endpoint; model must support JSON output.
# When AI_API_KEY is set, AI_CHAT_URL defaults to https://api.deepseek.com/chat/completions and AI_MODEL defaults to deepseek-chat.
AI_CHAT_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=edugrade
STORAGE_ACCESS_KEY=<app-storage-access-key>
STORAGE_SECRET_KEY=<app-storage-secret-key>
SMTP_URL=
MAIL_FROM=
